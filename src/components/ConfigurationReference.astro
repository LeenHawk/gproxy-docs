---
import schema from '../../public/generated/configuration.schema.json';
import defaults from '../../public/generated/configuration.defaults.json';
import SchemaFields from './SchemaFields.astro';
import { referenceText } from '../lib/reference-i18n';
const { locale = 'en' } = Astro.props;
const t = referenceText(locale);
---

<p><a href={`/generated/configuration.schema.json`}>{t.download} JSON Schema</a> · <a href="/generated/configuration.defaults.json">{t.defaults}</a></p>
<h2 id="appconfig">AppConfig</h2>
<SchemaFields schema={schema} locale={locale} />
{Object.entries(schema.$defs).map(([name, definition]) => (
  <section>
    <h2 id={name.toLowerCase()}>{name}</h2>
    {definition.description && <p>{definition.description}</p>}
    {definition.oneOf ? definition.oneOf.map((variant) => (
      <section>
        <h3>{variant.properties?.kind?.const ?? variant.title}</h3>
        {variant.description && <p>{variant.description}</p>}
        <SchemaFields schema={variant} locale={locale} />
      </section>
    )) : <SchemaFields schema={definition} locale={locale} />}
  </section>
))}
<h2 id="defaults">{t.defaults}</h2>
<pre><code class="language-json">{JSON.stringify(defaults, null, 2)}</code></pre>
<details>
  <summary>{t.completeSchema}</summary>
  <pre><code class="language-json">{JSON.stringify(schema, null, 2)}</code></pre>
</details>
