---
import api from '../../public/generated/openapi.json';
import ApiPayload from './ApiPayload.astro';
import { referenceText } from '../lib/reference-i18n';
const { locale = 'en' } = Astro.props;
const t = referenceText(locale);
---
<p><a href={`/generated/openapi.json`}>{t.jsonDownload} (OpenAPI)</a></p>
{Object.entries(api.components.schemas).map(([name,schema]) => <section>
  <h2 id={name}><code>{name}</code></h2>
  <details data-pagefind-ignore>
    <summary>{t.completeSchema}</summary>
    <ApiPayload schema={schema} locale={locale}/>
  </details>
</section>)}
